# JSON array of browser origins allowed to call the backend.
EVENTSCOUT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Server-only Postgres connection. Not needed for /health or the starter page.
# Copy the hosted Supabase session-pooler URI, URL-encode the password, and append ?sslmode=require.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
EVENTSCOUT_DATABASE_URL=

# Server-only keys for `pnpm index`, which embeds events with OpenAI and stores them in
# Pinecone. The index is created on first use.
EVENTSCOUT_OPENAI_API_KEY=
EVENTSCOUT_PINECONE_API_KEY=

# Local development only: chat as a single test owner until Google login exists.
# Never enable this anywhere reachable from the internet.
EVENTSCOUT_ALLOW_CHAT_WITHOUT_LOGIN=false
