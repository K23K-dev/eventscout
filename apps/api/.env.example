# JSON array of browser origins allowed to call the backend.
EVENTSCOUT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Supabase session-pooler URI, password URL-encoded, ending in ?sslmode=require.
EVENTSCOUT_DATABASE_URL=

# Server-only keys for AI search and `pnpm ingest`; the Pinecone index is made on first use.
EVENTSCOUT_OPENAI_API_KEY=
EVENTSCOUT_PINECONE_API_KEY=

# Public project URL (https://PROJECT_REF.supabase.co), used to check sign-in tokens.
EVENTSCOUT_SUPABASE_URL=
