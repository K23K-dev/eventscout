# Public configuration: VITE_ values are included in the browser bundle.
# Never put provider keys or Supabase service-role keys here.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google sign-in through Supabase, from Project Settings → API Keys. Both are public by design.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
