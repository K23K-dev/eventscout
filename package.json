{
  "name": "eventscout",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.15.0 <23",
    "pnpm": "10.21.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @eventscout/web dev",
    "dev:api": "uv run --directory apps/api uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "ingest": "uv run --directory apps/api --locked python -m app.ingestion",
    "enrich": "uv run --directory apps/api --locked python -m app.enrichment",
    "index": "uv run --directory apps/api --locked python -m app.indexing",
    "lint": "pnpm --filter @eventscout/web lint",
    "format": "pnpm --filter @eventscout/web format",
    "typecheck": "pnpm --filter @eventscout/web typecheck",
    "build": "pnpm --filter @eventscout/web build",
    "check:api": "uv run --directory apps/api --locked ruff check . && uv run --directory apps/api --locked ruff format --check . && uv run --directory apps/api --locked mypy",
    "check": "pnpm lint && pnpm build && pnpm check:api"
  }
}
